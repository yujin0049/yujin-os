MANIFEST = json.dumps({"name": "유진 피클", "short_name": "유진", "start_url": "/", "display": "standalone",
                       "background_color": "#0f1115", "theme_color": "#0f1115", "lang": "ko"}, ensure_ascii=False)


def serve(conf, port):
    import http.server
    queue = Queue(STATE)
    workers = int(conf["workers"])
    for _ in range(workers):
        threading.Thread(target=work, args=(conf, queue), daemon=True).start()

    class Handler(http.server.BaseHTTPRequestHandler):
        def _send(self, code, body, ctype="application/json"):
            data = (body if isinstance(body, str) else json.dumps(body, ensure_ascii=False)).encode("utf-8")
            self.send_response(code)
            self.send_header("Content-Type", ctype)
            self.send_header("Content-Length", str(len(data)))
            self.send_header("Cache-Control", "no-store")
            self.end_headers()
            self.wfile.write(data)

        def do_GET(self):
            parts = self.path.strip("/").split("/")
            if self.path in ("/", "/index.html"):
                self._send(200, PAGE, "text/html; charset=utf-8")
            elif self.path == "/manifest.webmanifest":
                self._send(200, MANIFEST, "application/manifest+json")
            elif parts == ["api", "chats"]:
                self._send(200, queue.chats())
            elif parts[:2] == ["api", "chats"] and len(parts) == 3 and parts[2].isdigit():
                self._send(200, queue.jobs(int(parts[2])))
            else:
                self._send(404, {"error": "없는 주소입니다: %s" % self.path})

        def do_POST(self):
            parts = self.path.strip("/").split("/")
            if parts[:2] == ["api", "retry"] and len(parts) == 3 and parts[2].isdigit():
                ok = queue.retry(int(parts[2]))
                return self._send(200 if ok else 409, {"ok": ok} if ok else {"error": "실패한 질문만 다시 보낼 수 있습니다."})
            if parts != ["api", "ask"]:
                return self._send(404, {"error": "없는 주소입니다: %s" % self.path})
            try:
                body = json.loads(self.rfile.read(int(self.headers.get("Content-Length") or 0)) or b"{}")
                question, chat = str(body.get("q", "")).strip(), body.get("chat")
            except (ValueError, AttributeError):
                question, chat = "", None
            if not question or not (chat is None or isinstance(chat, int)):
                return self._send(400, {"error": "질문을 q 칸에 담은 JSON으로 보내세요. 이어서 물을 때는 chat에 대화 번호. 예: {\"q\": \"이번 주 휴강\"}"})
            r = queue.add(chat, question)
            self._send(200 if r else 404, r or {"error": "대화 %s번이 없습니다. chat 없이 보내면 새 대화가 됩니다." % chat})

        def log_message(self, *a):
            pass

    print("yujin-ask: http://127.0.0.1:%d 에서 기다립니다(일꾼 %d명, 줄 %s)." % (port, workers, STATE), file=sys.stderr)
    http.server.ThreadingHTTPServer(("127.0.0.1", port), Handler).serve_forever()


def main(argv):
    if argv[:1] in (["-h"], ["--help"]):
        print(__doc__.strip())
        return 0
    conf = load_conf()
    if argv[:1] == ["serve"]:
        serve(conf, int(argv[1]) if len(argv) > 1 else 8090)
        return 0
    servers, route, tools = connect(conf)
    try:
        if argv[:1] == ["--tools"]:
            for t in tools:
                print(t["function"]["name"], "-", t["function"]["description"])
            return 0
        q = " ".join(argv).strip() or sys.stdin.read().strip()
        if not q:
            print(__doc__.strip())
            return 2
        out = ask(conf, route, tools, q)
        for fn in out["tools"]:
            print("· %s" % fn, file=sys.stderr)
        if "error" in out:
            print("yujin-ask: " + out["error"], file=sys.stderr)
            return 1
        print(out["answer"])
        return 0
    finally:
        for s in servers:
            s.close()


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
