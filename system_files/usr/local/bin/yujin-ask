.hint{display:flex;flex-wrap:wrap;gap:8px}
.hint button{border:1px solid var(--line);background:var(--panel);color:var(--fg);border-radius:999px;padding:7px 12px;font:inherit;font-size:14px}
form{display:flex;gap:8px;padding:10px 16px calc(env(safe-area-inset-bottom) + 10px);border-top:1px solid var(--line);background:var(--panel)}
textarea{flex:1;resize:none;border:1px solid var(--line);border-radius:12px;padding:10px 12px;font:inherit;background:var(--bg);color:var(--fg);max-height:120px}
form button{border:0;border-radius:12px;padding:0 16px;background:var(--me);color:var(--me-fg);font:inherit;font-weight:600}
form button:disabled{opacity:.5}
</style>
</head>
<body>
<header><h1>유진 피클</h1><p>이 기기의 로컬 AI · 학교 자료는 밖으로 나가지 않습니다</p></header>
<main id="log">
  <div class="msg ai">무엇을 볼까요? 숫자는 yujin-db에서 꺼내 옵니다.</div>
  <div class="hint" id="hint">
    <button type="button">이번 주 휴강·보강</button>
    <button type="button">11월분 초과강사료</button>
    <button type="button">장부 다음 할 일</button>
  </div>
</main>
<form id="f">
  <textarea id="q" rows="1" placeholder="물어보세요" aria-label="질문"></textarea>
  <button id="send" type="submit">보내기</button>
</form>
<script>
const LABEL = {yujin_kangsaryo:"초과강사료", yujin_jangbu:"장부", yujin_week:"한 주 수업", yujin_query:"DB 조회",
               yujin_summary:"요약", yujin_schema:"표 구조", yujin_flag:"확인필요 기록", yujin_doccheck:"공문 검사"};
const log = document.getElementById("log"), q = document.getElementById("q"), send = document.getElementById("send");
function add(text, cls, tools) {
  const d = document.createElement("div"); d.className = "msg " + cls; d.textContent = text;
  if (tools && tools.length) {
    const t = document.createElement("div"); t.className = "tools";
    for (const name of tools) { const s = document.createElement("span"); s.textContent = LABEL[name.split("__").pop()] || name; t.appendChild(s); }
    d.appendChild(t);
  }
  log.appendChild(d); log.scrollTop = log.scrollHeight; return d;
}
async function ask(text) {
  if (!text.trim() || send.disabled) return;
  add(text, "me"); q.value = ""; send.disabled = true;
  const wait = add("찾아보는 중…", "ai");
  try {
    const r = await fetch("/ask", {method: "POST", headers: {"Content-Type": "application/json"}, body: JSON.stringify({q: text})});
    const j = await r.json(); wait.remove();
    if (j.error) add(j.error, "ai err", j.tools); else add(j.answer || "(답이 비었습니다)", "ai", j.tools);
  } catch (e) { wait.remove(); add("맥북에 닿지 않습니다. 맥북이 켜져 있는지 보세요.", "ai err"); }
  send.disabled = false; q.focus();
}
document.getElementById("f").addEventListener("submit", e => { e.preventDefault(); ask(q.value); });
q.addEventListener("keydown", e => { if (e.key === "Enter" && !e.shiftKey && !e.isComposing) { e.preventDefault(); ask(q.value); } });
document.getElementById("hint").addEventListener("click", e => { if (e.target.tagName === "BUTTON") ask(e.target.textContent); });
</script>
</body>
</html>
"""

MANIFEST = json.dumps({"name": "유진 피클", "short_name": "유진", "start_url": "/", "display": "standalone",
                       "background_color": "#0f1115", "theme_color": "#0f1115", "lang": "ko"}, ensure_ascii=False)


def serve(conf, route, tools, port):
    import http.server

    class Handler(http.server.BaseHTTPRequestHandler):
        def _send(self, code, body, ctype):
            data = body.encode("utf-8")
            self.send_response(code)
            self.send_header("Content-Type", ctype)
            self.send_header("Content-Length", str(len(data)))
            self.send_header("Cache-Control", "no-store")
            self.end_headers()
            self.wfile.write(data)

        def do_GET(self):
            if self.path in ("/", "/index.html"):
                self._send(200, PAGE, "text/html; charset=utf-8")
            elif self.path == "/manifest.webmanifest":
                self._send(200, MANIFEST, "application/manifest+json")
            else:
                self._send(404, "없는 주소입니다.", "text/plain; charset=utf-8")

        def do_POST(self):
            if self.path != "/ask":
                return self._send(404, "없는 주소입니다.", "text/plain; charset=utf-8")
            try:
                question = str(json.loads(self.rfile.read(int(self.headers.get("Content-Length") or 0)) or b"{}").get("q", "")).strip()
            except (ValueError, AttributeError):
                question = None
            if not question:
                return self._send(400, json.dumps({"error": "질문을 q 칸에 담은 JSON으로 보내세요. 예: {\"q\": \"이번 주 휴강\"}"}, ensure_ascii=False), "application/json")
            try:
                out = ask(conf, route, tools, question)
            except OSError as e:
                out = {"answer": "", "tools": [], "error": "로컬 모델에 닿지 않습니다(%s). llama-server가 켜져 있는지 보세요." % e}
            self._send(200, json.dumps(out, ensure_ascii=False), "application/json")

        def log_message(self, *a):
            pass

    print("yujin-ask: http://127.0.0.1:%d 에서 기다립니다(한 번에 한 질문)." % port, file=sys.stderr)
    http.server.HTTPServer(("127.0.0.1", port), Handler).serve_forever()


def main(argv):
    if argv[:1] in (["-h"], ["--help"]):
        print(__doc__.strip())
        return 0
    conf = load_conf()
    servers, route, tools = connect(conf)
    try:
        if argv[:1] == ["--tools"]:
            for t in tools:
                print(t["function"]["name"], "-", t["function"]["description"])
            return 0
        if argv[:1] == ["serve"]:
            serve(conf, route, tools, int(argv[1]) if len(argv) > 1 else 8090)
            return 0
        q = " ".join(argv).strip() or sys.stdin.read().strip()
        if not q:
            print(__doc__.strip())
            return 2
        out = ask(conf, route, tools, q)
        for fn in out["tools"]:
            print("· %s" % fn, file=sys.stderr)
        if "error" in out:
            print("yujin-ask: " + out["error"], file=sys.stderr)
            return 1
        print(out["answer"])
        return 0
    finally:
        for s in servers:
            s.close()


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
