const HINTS = ["이번 주 휴강·보강", "11월분 초과강사료", "장부 다음 할 일"];
const $ = id => document.getElementById(id);
let cur = Number(new URLSearchParams(location.hash.slice(1)).get("c")) || null, shown = "";
const api = (path, body) => fetch(path, body ? {method: "POST", headers: {"Content-Type": "application/json"}, body: JSON.stringify(body)} : {}).then(r => r.json());
function el(tag, cls, text) { const d = document.createElement(tag); if (cls) d.className = cls; if (text != null) d.textContent = text; return d; }
function go(c) { cur = c; history.replaceState(null, "", c ? "#c=" + c : "#"); document.body.classList.remove("open"); shown = ""; refresh(); }
function renderJobs(jobs) {
  const key = JSON.stringify(jobs); if (key === shown) return; shown = key;
  const log = $("log"), atEnd = log.scrollHeight - log.scrollTop - log.clientHeight < 40; log.replaceChildren();
  if (!jobs.length) {
    log.append(el("div", "msg ai", "무엇을 볼까요? 숫자는 yujin-db에서 꺼내 옵니다."));
    const h = el("div", "hint"); for (const t of HINTS) { const b = el("button", "", t); b.type = "button"; b.onclick = () => send(t); h.append(b); } log.append(h); return;
  }
  for (const j of jobs) {
    log.append(el("div", "msg me", j.q));
    let d;
    if (j.status === "대기") d = el("div", "msg ai wait", j.ahead ? "줄 서는 중 · 앞에 " + j.ahead + "개" : "곧 시작합니다");
    else if (j.status === "처리중") d = el("div", "msg ai wait", "찾아보는 중…");
    else if (j.status === "실패") { d = el("div", "msg ai err", j.error); const b = el("button", "", "다시"); b.type = "button"; b.onclick = () => api("/api/retry/" + j.id, {}).then(refresh); d.append(b); }
    else d = el("div", "msg ai", j.answer || "(답이 비었습니다)");
    if (j.tools.length) { const t = el("div", "tools"); for (const n of j.tools) t.append(el("span", "", LABEL[n.split("__").pop()] || n)); d.append(t); }
    log.append(d);
  }
  if (atEnd) log.scrollTop = log.scrollHeight;
}
async function refresh() {
  try {
    const chats = await api("/api/chats"), nav = $("chats"); nav.replaceChildren();
    for (const c of chats) { const a = el("a", c.id === cur ? "on" : ""); a.href = "#c=" + c.id; a.onclick = e => { e.preventDefault(); go(c.id); }; a.append(el("span", "", c.title)); if (c.busy) a.append(el("i")); nav.append(a); }
    const mine = chats.find(c => c.id === cur); $("title").textContent = mine ? mine.title : "새 대화";
    renderJobs(cur ? await api("/api/chats/" + cur) : []);
  } catch (e) { $("title").textContent = "맥북에 닿지 않습니다 — 다시 시도 중"; }
}
async function send(text) {
  if (!text.trim()) return; $("q").value = "";
  const r = await api("/api/ask", {q: text, chat: cur});
  if (r.error) { alert(r.error); return; }
  if (r.chat !== cur) go(r.chat); else refresh();
}
$("f").onsubmit = e => { e.preventDefault(); send($("q").value); };
$("q").onkeydown = e => { if (e.key === "Enter" && !e.shiftKey && !e.isComposing) { e.preventDefault(); send($("q").value); } };
$("new").onclick = () => go(null);
$("menu").onclick = () => document.body.classList.add("open");
$("dim").onclick = () => document.body.classList.remove("open");
refresh(); setInterval(refresh, 1500);
</script>
