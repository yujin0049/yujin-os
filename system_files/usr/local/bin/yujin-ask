#!/usr/bin/python3
"""yujin-ask — 로컬 모델(llama-server)에게 묻고, 모델이 MCP 도구(yujin-db 등)를 직접 쓰게 한다.

  yujin-ask "이번 주 휴강 몇 건?"
  yujin-ask --tools          # 쓸 수 있는 도구만 보기
  yujin-ask serve [포트]     # 휴대폰·브라우저용 채팅 화면(127.0.0.1:8090, 한 번에 한 질문)

설정 (뒤가 앞을 덮음): /etc/yujin-os/agent.json, ~/.config/yujin-os/agent.json
  {"llm": "http://127.0.0.1:8080/v1",
   "mcp": {"yujin-db": ["python3", "-I", "-X", "utf8", "/var/home/yujin/yujin-db/mcp_server.py"]},
   "max_steps": 8}
밖으로 나가는 통신 없음: llm 주소가 127.0.0.1/localhost가 아니면 거부한다.
결재·상신·발송·돈·삭제 도구는 붙이지 않는다(사람만 하는 일).
"""
import json
import os
import subprocess
import sys
import urllib.parse
import urllib.request

SYSTEM = ("너는 유진님의 업무 보조다. 사실(날짜·시수·금액·사람)은 반드시 도구로 확인하고 답한다. "
          "도구에 없는 사실은 지어내지 말고 「확인 필요」라고 말한다. 먼저 요약 도구를 쓰고, 더 필요할 때만 쿼리한다. "
          "결재·상신·외부 발송·돈·삭제는 하지 않고 유진님 일로 남긴다. 한국어로 짧게 답한다.")


def load_conf():
    conf = {"llm": "http://127.0.0.1:8080/v1", "mcp": {}, "max_steps": 8}
    paths = ["/etc/yujin-os/agent.json",
             os.path.join(os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config"), "yujin-os", "agent.json")]
    extra = os.environ.get("YUJIN_AGENT_CONF")
    if extra:
        paths.append(extra)
    for p in paths:
        try:
            with open(p, encoding="utf-8") as f:
                d = json.load(f)
        except (OSError, ValueError):
            continue
        for k in ("llm", "max_steps"):
            if k in d:
                conf[k] = d[k]
        if isinstance(d.get("mcp"), dict):
            conf["mcp"].update(d["mcp"])
    host = urllib.parse.urlparse(conf["llm"]).hostname
    if host not in ("127.0.0.1", "localhost", "::1"):
        sys.exit("yujin-ask: llm 주소는 이 기기(127.0.0.1)만 됩니다: %s" % conf["llm"])
    return conf


class MCP:
    """stdio MCP 클라이언트 (한 줄 = JSON-RPC 한 개)."""

    def __init__(self, name, argv):
        self.name = name
        self.p = subprocess.Popen(argv, stdin=subprocess.PIPE, stdout=subprocess.PIPE,
                                  stderr=subprocess.DEVNULL, text=True, encoding="utf-8")
        self.n = 0
        self.call("initialize", {"protocolVersion": "2025-06-18", "capabilities": {},
                                 "clientInfo": {"name": "yujin-ask", "version": "0.1"}})
        self._send({"jsonrpc": "2.0", "method": "notifications/initialized"})
        self.tools = self.call("tools/list", {}).get("tools", [])

    def _send(self, msg):
        self.p.stdin.write(json.dumps(msg, ensure_ascii=False) + "\n")
        self.p.stdin.flush()

    def call(self, method, params):
        self.n += 1
        self._send({"jsonrpc": "2.0", "id": self.n, "method": method, "params": params})
        while True:
            line = self.p.stdout.readline()
            if not line:
                raise RuntimeError("%s MCP 서버가 끝났습니다" % self.name)
            r = json.loads(line)
            if r.get("id") == self.n:
                if "error" in r:
                    raise RuntimeError(r["error"].get("message"))
                return r.get("result") or {}

    def close(self):
        self.p.stdin.close()
        try:
            self.p.wait(timeout=5)
        except subprocess.TimeoutExpired:
            self.p.kill()


def chat(llm, messages, tools):
    body = {"model": "local", "messages": messages, "temperature": 0.2}
    if tools:
        body["tools"] = tools
    req = urllib.request.Request(llm.rstrip("/") + "/chat/completions", data=json.dumps(body).encode(),
                                 headers={"Content-Type": "application/json"})
    with urllib.request.urlopen(req, timeout=600) as r:
        return json.load(r)["choices"][0]["message"]


def connect(conf):
    servers, route, tools = [], {}, []
    for name, cmd in conf["mcp"].items():
        s = MCP(name, cmd)
        servers.append(s)
        for t in s.tools:
            fn = "%s__%s" % (name, t["name"])
            route[fn] = (s, t["name"])
            tools.append({"type": "function", "function": {
                "name": fn, "description": t.get("description", ""),
                "parameters": t.get("inputSchema") or {"type": "object", "properties": {}}}})
    return servers, route, tools


def ask(conf, route, tools, question):
    messages = [{"role": "system", "content": SYSTEM}, {"role": "user", "content": question}]
    used = []
    for _ in range(int(conf["max_steps"])):
        m = chat(conf["llm"], messages, tools)
        calls = m.get("tool_calls") or []
        messages.append({k: v for k, v in m.items() if k in ("role", "content", "tool_calls")})
        if not calls:
            return {"answer": (m.get("content") or "").strip(), "tools": used}
        for c in calls:
            fn = c["function"]["name"]
            try:
                args = json.loads(c["function"].get("arguments") or "{}")
                s, tn = route[fn]
                res = s.call("tools/call", {"name": tn, "arguments": args})
                text = "\n".join(x.get("text", "") for x in res.get("content", []) if x.get("type") == "text")
            except (KeyError, ValueError, RuntimeError) as e:
                text = "오류: %s" % e
            used.append(fn)
            messages.append({"role": "tool", "tool_call_id": c.get("id", fn), "content": text[:20000]})
    return {"answer": "", "tools": used, "error": "단계가 %s번을 넘어 멈췄습니다. 질문을 좁혀 주세요." % conf["max_steps"]}


PAGE = """<!doctype html>
<html lang="ko">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-title" content="유진">
<meta name="theme-color" content="#0f1115">
<link rel="manifest" href="/manifest.webmanifest">
<title>유진 피클</title>
<style>
:root{--bg:#f6f7f9;--panel:#fff;--fg:#1b1f24;--muted:#66707b;--line:#dde2e8;--me:#1f5f8b;--me-fg:#fff;--chip:#eef2f6;--err:#b42318}
@media (prefers-color-scheme:dark){:root{--bg:#0f1115;--panel:#171a20;--fg:#e7ebef;--muted:#98a2ad;--line:#2a2f37;--me:#3d7fb0;--me-fg:#fff;--chip:#20252d;--err:#f97066}}
*{box-sizing:border-box}
html,body{height:100%;margin:0}
