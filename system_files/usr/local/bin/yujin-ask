#!/usr/bin/python3
"""yujin-ask — 로컬 모델(llama-server)에게 묻고, 모델이 MCP 도구(yujin-db 등)를 직접 쓰게 한다.

  yujin-ask "이번 주 휴강 몇 건?"
  yujin-ask --tools          # 쓸 수 있는 도구만 보기
  yujin-ask serve [포트]     # 휴대폰·브라우저용 채팅 화면(127.0.0.1:8090)

serve: 대화 여러 개를 동시에 보낼 수 있다. 질문은 먼저 디스크(~/.local/state/yujin-os/ask.db)에 적고 줄을 세운 뒤
workers명이 차례로 처리한다(workers = llama-server -np 칸 수). 꺼졌다 켜지면 끝나지 않은 질문을 이어서 처리한다.

설정 (뒤가 앞을 덮음): /etc/yujin-os/agent.json, ~/.config/yujin-os/agent.json
  {"llm": "http://127.0.0.1:8080/v1",
   "mcp": {"yujin-db": ["python3", "-I", "-X", "utf8", "/var/home/yujin/yujin-db/mcp_server.py"]},
   "max_steps": 8, "workers": 1}
밖으로 나가는 통신 없음: llm 주소가 127.0.0.1/localhost가 아니면 거부한다.
결재·상신·발송·돈·삭제 도구는 붙이지 않는다(사람만 하는 일).
"""
import json
import os
import sqlite3
import subprocess
import sys
import threading
import urllib.parse
import urllib.request

SYSTEM = ("너는 유진님의 업무 보조다. 사실(날짜·시수·금액·사람)은 반드시 도구로 확인하고 답한다. "
          "도구에 없는 사실은 지어내지 말고 「확인 필요」라고 말한다. 질문에 맞는 도구 하나를 먼저 쓰고, 모자랄 때만 다른 도구를 쓴다. "
          "결재·상신·외부 발송·돈·삭제는 하지 않고 유진님 일로 남긴다. "
          "도구와 자료로 할 수 없는 일은 「안 된다」로 끝내지 말고, 무엇이 없어서 못 하는지 한 줄로 말한 뒤 "
          "「회사컴에 맡길 일」로 할 일·필요한 자료·마감을 세 줄로 정리해 준다. 한국어로 짧게 답한다.")


def load_conf():
    conf = {"llm": "http://127.0.0.1:8080/v1", "mcp": {}, "max_steps": 8, "workers": 1}
    paths = ["/etc/yujin-os/agent.json",
             os.path.join(os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config"), "yujin-os", "agent.json")]
    extra = os.environ.get("YUJIN_AGENT_CONF")
    if extra:
        paths.append(extra)
    for p in paths:
        try:
            with open(p, encoding="utf-8") as f:
                d = json.load(f)
        except (OSError, ValueError):
            continue
        for k in ("llm", "max_steps", "workers"):
            if k in d:
                conf[k] = d[k]
        if isinstance(d.get("mcp"), dict):
            conf["mcp"].update(d["mcp"])
    host = urllib.parse.urlparse(conf["llm"]).hostname
    if host not in ("127.0.0.1", "localhost", "::1"):
        sys.exit("yujin-ask: llm 주소는 이 기기(127.0.0.1)만 됩니다: %s" % conf["llm"])
    return conf


class MCP:
    """stdio MCP 클라이언트 (한 줄 = JSON-RPC 한 개)."""

    def __init__(self, name, argv):
        self.name = name
        self.p = subprocess.Popen(argv, stdin=subprocess.PIPE, stdout=subprocess.PIPE,
                                  stderr=subprocess.DEVNULL, text=True, encoding="utf-8")
        self.n = 0
        self.call("initialize", {"protocolVersion": "2025-06-18", "capabilities": {},
                                 "clientInfo": {"name": "yujin-ask", "version": "0.1"}})
        self._send({"jsonrpc": "2.0", "method": "notifications/initialized"})
        self.tools = self.call("tools/list", {}).get("tools", [])

    def _send(self, msg):
        self.p.stdin.write(json.dumps(msg, ensure_ascii=False) + "\n")
        self.p.stdin.flush()

    def call(self, method, params):
        self.n += 1
        self._send({"jsonrpc": "2.0", "id": self.n, "method": method, "params": params})
        while True:
            line = self.p.stdout.readline()
            if not line:
                raise RuntimeError("%s MCP 서버가 끝났습니다" % self.name)
            r = json.loads(line)
            if r.get("id") == self.n:
                if "error" in r:
                    raise RuntimeError(r["error"].get("message"))
                return r.get("result") or {}

    def close(self):
        self.p.stdin.close()
        try:
            self.p.wait(timeout=5)
        except subprocess.TimeoutExpired:
            self.p.kill()


def chat(llm, messages, tools):
    body = {"model": "local", "messages": messages, "temperature": 0.2, "chat_template_kwargs": {"enable_thinking": False}}
    if tools:
        body["tools"] = tools
    req = urllib.request.Request(llm.rstrip("/") + "/chat/completions", data=json.dumps(body).encode(),
                                 headers={"Content-Type": "application/json"})
    with urllib.request.urlopen(req, timeout=600) as r:
        return json.load(r)["choices"][0]["message"]


def connect(conf):
    servers, route, tools = [], {}, []
    for name, cmd in conf["mcp"].items():
        s = MCP(name, cmd)
        servers.append(s)
        for t in s.tools:
            fn = "%s__%s" % (name, t["name"])
            route[fn] = (s, t["name"])
            tools.append({"type": "function", "function": {
                "name": fn, "description": t.get("description", ""),
                "parameters": t.get("inputSchema") or {"type": "object", "properties": {}}}})
    return servers, route, tools


def ask(conf, route, tools, question, history=()):
    messages = [{"role": "system", "content": SYSTEM}]
    for q, a in history:
        messages += [{"role": "user", "content": q}, {"role": "assistant", "content": a}]
    messages.append({"role": "user", "content": question})
    used = []
    for _ in range(int(conf["max_steps"])):
        m = chat(conf["llm"], messages, tools)
        calls = m.get("tool_calls") or []
        messages.append({k: v for k, v in m.items() if k in ("role", "content", "tool_calls")})
        if not calls:
            return {"answer": (m.get("content") or "").strip(), "tools": used}
        for c in calls:
            fn = c["function"]["name"]
            try:
                args = json.loads(c["function"].get("arguments") or "{}")
                s, tn = route[fn]
                res = s.call("tools/call", {"name": tn, "arguments": args})
                text = "\n".join(x.get("text", "") for x in res.get("content", []) if x.get("type") == "text")
            except (KeyError, ValueError, RuntimeError) as e:
                text = "오류: %s" % e
            used.append(fn)
            messages.append({"role": "tool", "tool_call_id": c.get("id", fn), "content": text[:20000]})
    return {"answer": "", "tools": used, "error": "단계가 %s번을 넘어 멈췄습니다. 질문을 좁혀 주세요." % conf["max_steps"]}


STATE = os.path.join(os.environ.get("XDG_STATE_HOME") or os.path.expanduser("~/.local/state"), "yujin-os", "ask.db")

SCHEMA = """
CREATE TABLE IF NOT EXISTS 대화 (
  번호 INTEGER PRIMARY KEY,
  제목 TEXT NOT NULL
) STRICT;
CREATE TABLE IF NOT EXISTS 질문 (
  번호 INTEGER PRIMARY KEY,
  대화 INTEGER NOT NULL REFERENCES 대화(번호),
  글 TEXT NOT NULL,
  상태 TEXT NOT NULL DEFAULT '대기' CHECK (상태 IN ('대기', '처리중', '끝', '실패')),
  답 TEXT,
  도구 TEXT NOT NULL DEFAULT '[]',
  오류 TEXT,
  받은때 TEXT NOT NULL DEFAULT (datetime('now', 'localtime')),
  끝난때 TEXT
) STRICT;
"""


class Queue:
    def __init__(self, path):
        os.makedirs(os.path.dirname(path), exist_ok=True)
        self.db = sqlite3.connect(path, isolation_level=None, check_same_thread=False)
        self.db.execute("PRAGMA journal_mode = WAL")
        self.db.executescript(SCHEMA)
        self.db.execute("UPDATE 질문 SET 상태 = '대기' WHERE 상태 = '처리중'")
        self.cv = threading.Condition()

    def add(self, chat, text):
        with self.cv:
            if chat is None:
                chat = self.db.execute("INSERT INTO 대화 (제목) VALUES (?)", (text[:40],)).lastrowid
            elif not self.db.execute("SELECT 1 FROM 대화 WHERE 번호 = ?", (chat,)).fetchone():
                return None
            n = self.db.execute("INSERT INTO 질문 (대화, 글) VALUES (?, ?)", (chat, text)).lastrowid
            self.cv.notify()
            return {"chat": chat, "id": n}

    def retry(self, n):
        with self.cv:
            changed = self.db.execute("UPDATE 질문 SET 상태 = '대기', 오류 = NULL WHERE 번호 = ? AND 상태 = '실패'", (n,)).rowcount
            self.cv.notify()
            return changed == 1

    def take(self):
        with self.cv:
            while True:
                row = self.db.execute("SELECT 번호, 대화, 글 FROM 질문 WHERE 상태 = '대기' ORDER BY 번호 LIMIT 1").fetchone()
                if row:
                    self.db.execute("UPDATE 질문 SET 상태 = '처리중' WHERE 번호 = ?", (row[0],))
                    history = self.db.execute("SELECT 글, 답 FROM 질문 WHERE 대화 = ? AND 번호 < ? AND 상태 = '끝' "
                                              "ORDER BY 번호 DESC LIMIT 4", (row[1], row[0])).fetchall()
                    return row[0], row[2], history[::-1]
                self.cv.wait()

    def finish(self, n, out):
        with self.cv:
            self.db.execute("UPDATE 질문 SET 상태 = ?, 답 = ?, 도구 = ?, 오류 = ?, 끝난때 = datetime('now', 'localtime') WHERE 번호 = ?",
                            ("실패" if out.get("error") else "끝", out.get("answer"),
                             json.dumps(out.get("tools", []), ensure_ascii=False), out.get("error"), n))

    def chats(self):
        with self.cv:
            rows = self.db.execute("SELECT d.번호, d.제목, SUM(q.상태 IN ('대기', '처리중')) FROM 대화 d JOIN 질문 q ON q.대화 = d.번호 "
                                   "GROUP BY d.번호 ORDER BY MAX(q.번호) DESC LIMIT 50").fetchall()
        return [{"id": a, "title": b, "busy": bool(c)} for a, b, c in rows]

    def jobs(self, chat):
        with self.cv:
            rows = self.db.execute("SELECT 번호, 글, 상태, 답, 도구, 오류, (SELECT COUNT(*) FROM 질문 p WHERE p.상태 IN ('대기', '처리중') "
                                   "AND p.번호 < q.번호) FROM 질문 q WHERE 대화 = ? ORDER BY 번호", (chat,)).fetchall()
        return [{"id": n, "q": g, "status": st, "answer": a, "tools": json.loads(t), "error": e, "ahead": ah}
                for n, g, st, a, t, e, ah in rows]


def work(conf, queue):
    servers, route, tools = connect(conf)
    while True:
        n, text, history = queue.take()
        try:
            out = ask(conf, route, tools, text, history)
        except OSError as e:
            out = {"answer": "", "tools": [], "error": "로컬 모델에 닿지 않습니다(%s). llama-server가 켜져 있는지 보고 「다시」를 누르세요." % e}
        except Exception as e:
            out = {"answer": "", "tools": [], "error": "처리하다 멈췄습니다(%s: %s). 「다시」를 누르세요." % (type(e).__name__, e)}
        queue.finish(n, out)
        if any(s.p.poll() is not None for s in servers):
            for s in servers:
                s.close()
            servers, route, tools = connect(conf)


